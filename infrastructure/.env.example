# Generate Authentik secret key with: openssl rand -base64 36
AUTHENTIK_SECRET_KEY=your-super-secret-key-at-least-50-chars-long-change-this

# Database passwords (change these to secure values)
AUTHENTIK_DB_PASSWORD=secure-authentik-db-password
AUTHENTIK_REDIS_PASSWORD=changeme
DIETPLANNER_DB_PASSWORD=secure-dietplanner-db-password

# Authentik bootstrap — applied only on first run to the akadmin account
AUTHENTIK_BOOTSTRAP_PASSWORD=change-this-admin-password
AUTHENTIK_BOOTSTRAP_EMAIL=admin@home-system.local
# Optionally create a static API token for akadmin (useful for scripting/IaC)
# AUTHENTIK_BOOTSTRAP_TOKEN=your-static-api-token
