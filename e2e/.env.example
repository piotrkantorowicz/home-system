# E2E Test Environment Variables
# Copy this file to .env and fill in the values.

# Playwright base URL (frontend dev server)
PLAYWRIGHT_BASE_URL=http://localhost:5173

# Backend API base URL
API_BASE_URL=http://localhost:5000

# Shared password for the four E2eWorker users provisioned by the Authentik
# blueprint. Must match the E2E_USER_PASSWORD value in infrastructure/.env.
# Required — the suite throws a clear error if unset.
TEST_USER_PASSWORD=change-this-e2e-password

# Optional per-worker overrides for edge cases (username + password). Without
# these, the fixture and setup derive the username from the worker index
# (E2eWorker0..E2eWorker3) and reuse TEST_USER_PASSWORD for the password.
# TEST_USER_EMAIL_0=E2eWorker0
# TEST_USER_PASSWORD_0=...
