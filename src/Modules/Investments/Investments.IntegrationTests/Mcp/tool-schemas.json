  {
    "name": "update_wallet",
    "title": null,
    "description": "Renames a wallet and/or changes its visibility; owner, kind and currency cannot change. Send both fields and the version from get_wallet. A version conflict means it changed since: call get_wallet and decide again.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "walletId": {
          "description": "Wallet id from list_wallets.",
          "type": "string",
          "format": "uuid"
        },
        "name": {
          "description": "Display name, 1-80 characters; send the current one to keep it.",
          "type": "string"
        },
        "visibility": {
          "description": "Shared or Private; send the current one to keep it. Changing it needs the owner or an adult managing them.",
          "type": "string"
        },
        "version": {
          "description": "The wallet's version from get_wallet or list_wallets.",
          "type": "integer"
        }
      },
      "required": [
        "walletId",
        "name",
        "visibility",
        "version"
      ]
