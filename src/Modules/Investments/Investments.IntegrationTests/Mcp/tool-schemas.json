          "items": {
            "type": "object",
            "properties": {
              "walletId": {
                "type": "string",
                "format": "uuid"
              },
              "amount": {
                "type": "string"
              },
              "note": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "walletId",
              "amount",
              "note"
            ]
          }
