  {
    "name": "create_wallet",
    "title": null,
    "description": "Creates an investment wallet in the caller's household, for the caller or a member the caller manages. Not idempotent: after a lost response, check list_wallets before calling again. An invalid institution, kind or currency lists the allowed values.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "name": {
          "description": "Display name, 1-80 characters.",
          "type": "string"
        },
        "institution": {
          "description": "Institution, e.g. XTB or PKOBP.",
          "type": "string"
        },
        "kind": {
          "description": "Account kind, e.g. Brokerage, IKE, IKZE or Savings.",
          "type": "string"
        },
        "currency": {
          "description": "PLN, EUR or USD; cannot change later.",
          "type": "string"
        },
        "visibility": {
          "description": "Shared (the household sees it) or Private (owner and managing adults only).",
          "type": "string"
        },
        "ownerPersonId": {
          "description": "Owner person id, for a member the caller manages; the caller when omitted.",
          "type": [
            "string",
            "null"
          ],
          "format": "uuid",
          "default": null
        }
      },
      "required": [
        "name",
        "institution",
        "kind",
        "currency",
        "visibility"
      ]
    },
    "outputSchema": null,
