{
  "permissions": {
    "allow": [
      "Bash(./scripts/verify.sh:*)",
      "Bash(bash scripts/:*)",
      "Bash(docker compose:*)",
      "Bash(docker info:*)",
      "Bash(dotnet build:*)",
      "Bash(dotnet ef:*)",
      "Bash(dotnet format:*)",
      "Bash(dotnet test:*)",
      "Bash(gh issue:*)",
      "Bash(gh pr:*)",
      "Bash(gh run:*)",
      "Bash(git add:*)",
      "Bash(git branch:*)",
      "Bash(git checkout:*)",
      "Bash(git commit:*)",
      "Bash(git diff:*)",
      "Bash(git fetch origin main)",
      "Bash(git fetch origin)",
      "Bash(git fetch)",
      "Bash(git log:*)",
      "Bash(git ls-files:*)",
      "Bash(git merge-base:*)",
      "Bash(git pull --ff-only)",
      "Bash(git pull)",
      "Bash(git push --force-with-lease origin HEAD)",
      "Bash(git push --force-with-lease)",
      "Bash(git push -u origin HEAD)",
      "Bash(git push)",
      "Bash(git rev-parse:*)",
      "Bash(git show:*)",
      "Bash(git status:*)",
      "Bash(git switch:*)",
      "Bash(git worktree:*)",
      "Bash(npm ci)",
      "Bash(npm install)",
      "Bash(npm run:*)",
      "Bash(npm test:*)",
      "Bash(npx eslint:*)",
      "Bash(npx playwright:*)",
      "Bash(npx prettier:*)",
      "Bash(npx tsc:*)",
      "Bash(npx vitest:*)",
      "Bash(scripts/verify.sh:*)"
    ],
    "deny": [
      "Bash(git reset --hard:*)",
      "Bash(gh repo delete:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/hooks/guard-git.sh\"",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/hooks/guard-rules.sh\"",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/hooks/format-on-edit.sh\"",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "pk": {
      "source": {
        "source": "git",
        "url": "git@github.com:piotrkantorowicz/agent-skills.git"
      }
    }
  },
  "enabledPlugins": {
    "dev-loop@pk": true
  }
}
